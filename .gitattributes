* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Keep source and configuration files consistent across Windows and Linux.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.ps1 text eol=crlf

# Preserve the repository language classification for notebooks.
*.ipynb linguist-language=Python
